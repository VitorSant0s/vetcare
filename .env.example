# Copie para .env na raiz do projeto: cp .env.example .env
# O Spring Boot importa este arquivo automaticamente.
DB_URL=jdbc:postgresql://localhost:5432/vetcare
DB_USER=vetcare
DB_PASSWORD=vetcare
REDIS_HOST=localhost
REDIS_PORT=6379

# Deixe em branco para gerar um segredo aleatório por execução.
# Em ambiente compartilhado, defina um valor com 32+ caracteres.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120

# true cria os dados de demonstração (apenas para desenvolvimento/apresentação)
APP_SEED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVER_PORT=8080
