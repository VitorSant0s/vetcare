# Copie para .env na raiz do projeto: cp .env.example .env
# O Spring Boot importa este arquivo automaticamente.

DB_URL=jdbc:postgresql://localhost:5432/vetcare
DB_USER=vetcare
DB_PASSWORD=vetcare
REDIS_HOST=localhost
REDIS_PORT=6379

# Segredo JWT: deixe vazio para gerar um aleatório por execução.
# Em produção, use 32+ caracteres estáveis.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120

# Primeiro administrador (criado somente se não existir admin ativo).
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=
ADMIN_NOME=Administrador

# Envio real de notificações por SMTP.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=no-reply@seudominio.com
NOTIFICACOES_CANAL=SMTP

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVER_PORT=8080
